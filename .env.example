# Скопируйте файл в `.env`. Переменные процесса имеют приоритет.
# Относительные пути считаются от каталога проекта.
CYBRAN_DATABASE=instance/cybran.sqlite3
PAYMENT_METHODS=Наличные,Kaspi,Карта

# Локальное подключение Waitress и телефона.
HOST=0.0.0.0
PORT=5000
MOBILE_IP=
COOKIE_SECURE=0

# Оставьте пустым для локального `instance/session.key`.
# В production задайте собственный защищённый секрет.
# SECRET_KEY=

# Задавайте только за контролируемым HTTPS reverse proxy.
TRUSTED_PROXY_HOPS=0
