# Copy this file to .env. Shell variables override values from this file.
# Paths relative to this file are resolved from the project directory.
CYBRAN_DATABASE=instance/demo.sqlite3
PAYMENT_METHODS=Наличные,Kaspi,Карта

# Local Waitress / phone connection.
HOST=0.0.0.0
PORT=5000
MOBILE_IP=
COOKIE_SECURE=0

# Leave empty for the generated local instance/session.key.
# Production should provide its own protected secret.
# SECRET_KEY=

# Set only behind a controlled HTTPS reverse proxy.
TRUSTED_PROXY_HOPS=0
